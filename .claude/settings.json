{
  "effortLevel": "medium",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(stat:*)",
      "Bash(nix flake show:*)",
      "Bash(nix flake metadata:*)",
      "Bash(nix eval:*)",
      "Bash(sudo nixos-rebuild dry-build:*)",
      "Bash(bash scripts/preflight.sh:*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(nix flake check:*)",
      "Bash(nixos-rebuild switch:*)",
      "Bash(sudo nixos-rebuild switch:*)",
      "Bash(nixos-rebuild boot:*)",
      "Bash(sudo nixos-rebuild boot:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
